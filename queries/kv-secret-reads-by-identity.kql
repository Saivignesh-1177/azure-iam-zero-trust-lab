// Who read which secret, from where? (AU-6, AC-3)  ATT&CK T1555.006
// Expect: only the workload identity reading app-db-password, from the VM subnet.
AzureDiagnostics
| where ResourceProvider == "MICROSOFT.KEYVAULT" and Category == "AuditEvent"
| where OperationName in ("SecretGet", "SecretList", "SecretSet", "SecretDelete")
| extend Secret = tostring(split(id_s, "/")[4])
| project TimeGenerated, OperationName, Secret, ResultSignature, httpStatusCode_d,
          CallerObjectId = identity_claim_oid_g, CallerAppId = identity_claim_appid_g, CallerIPAddress
| order by TimeGenerated desc
