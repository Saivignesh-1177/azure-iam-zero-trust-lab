# systemd unit for zt-app. The service account is the ONLY non-root account allowed to ask
# Azure Arc for a token (via membership of the 'himds' group). Everything else is sandboxed.
[Unit]
Description=Zero Trust lab workload (reads one Key Vault secret via Azure Arc managed identity)
After=network-online.target himdsd.service
Wants=network-online.target

[Service]
Type=simple
User=ztapp
Group=ztapp
SupplementaryGroups=himds
EnvironmentFile=/etc/zt-app/app.env
ExecStart=/usr/bin/python3 /opt/zt-app/zt_app.py
Restart=on-failure
RestartSec=5

# --- sandbox (CM-7 least functionality, SC-39 process isolation) ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
